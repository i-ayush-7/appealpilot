# Nebius Token Factory — create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model ids. Leave blank to auto-discover Nemotron Nano / Super / Ultra from /v1/models.
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# USD per 1M tokens, used only for the cost trace in the UI. Update from the Token Factory pricing page.
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00

# Reviewer score below which the letter is revised and re-scored.
REVISE_THRESHOLD=85
# Set to 1 to force canned outputs even with a key.
APPEALPILOT_DEMO=

# Credit protection
# Hard stop on estimated spend, tracked in .cache/spend.json across restarts.
MAX_SPEND_USD=5
# Replay identical requests from disk instead of paying for them again.
LLM_CACHE=1
# Per-visitor limit on runs of non-sample cases.
RUNS_PER_HOUR=6
