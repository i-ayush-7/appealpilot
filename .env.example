# Nebius Token Factory — create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model ids. Leave blank to auto-discover Nemotron Nano / Super / Ultra from /v1/models.
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# USD per 1M tokens, used only for the cost trace in the UI. Update from the Token Factory pricing page.
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00

# Reviewer score below which the letter is revised and re-scored.
REVISE_THRESHOLD=85
# Set to 1 to force canned outputs even with a key.
APPEALPILOT_DEMO=

# Credit protection
# Hard stop on estimated spend, tracked in .cache/spend.json across restarts.
MAX_SPEND_USD=5
# Replay identical requests from disk instead of paying for them again.
LLM_CACHE=1
# Per-visitor limit on runs of non-sample cases.
RUNS_PER_HOUR=6
# Daily cap on estimated spend (UTC day). When reached, live runs stop; sample cases keep working.
DAILY_SPEND_USD=1.5
# Per-visitor limit on the wizard's letter-reading step (non-sample letters).
INTAKES_PER_HOUR=30
# Live (non-cached) runs allowed at the same time; extra runs queue for up to 45s.
MAX_CONCURRENT_RUNS=2
# Set to 1 only behind a reverse proxy that appends X-Forwarded-For (most hosting platforms).
TRUST_PROXY=
# Sample case dates are anchored to this day so their bundled cache stays valid.
SAMPLE_ANCHOR=2026-11-20
